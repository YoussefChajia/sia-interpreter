// Benchmark: Parallel Iterative Summation

// --- Configuration ---
sum_limit = 1000000;
num_tasks = 4;

// --- Iterative Sum function ---

function iterative_sum(limit) {
    total = 0;
    i = 0;
    loop (limit + 1) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

// --- Parallel execution ---
print("Starting", num_tasks, "parallel summation tasks up to", sum_limit);

parallel {
    {
        // Task 1
        print("Parallel Sum Task 1 starting");
        task1_result = iterative_sum(sum_limit);
        print("Parallel Sum Task 1 finished:", task1_result);
    }
    {
        // Task 2
        print("Parallel Sum Task 2 starting");
        task2_result = iterative_sum(sum_limit);
        print("Parallel Sum Task 2 finished:", task2_result);
    }
    {
        // Task 3
        print("Parallel Sum Task 3 starting");
        task3_result = iterative_sum(sum_limit);
        print("Parallel Sum Task 3 finished:", task3_result);
    }
    {
        // Task 4
        print("Parallel Sum Task 4 starting");
        task4_result = iterative_sum(sum_limit);
        print("Parallel Sum Task 4 finished:", task4_result);
    }
}

print("Parallel summation tasks completed."); 

